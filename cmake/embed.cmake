# gob2native - a file as a C++ byte array (fonts compiled into the app)
# SPDX-License-Identifier: GPL-3.0-or-later
#
# cmake -DINPUT=<file> -DOUTPUT=<file.cpp> -DNAME=<identifier> -P embed.cmake
# writes gob::embedded::NAME (const unsigned char[]) and NAMESize (size_t).

file(READ "${INPUT}" hex HEX)
string(LENGTH "${hex}" digits)
math(EXPR size "${digits} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){24})" "\\1\n\t" bytes "${bytes}")
get_filename_component(source "${INPUT}" NAME)
file(WRITE "${OUTPUT}"
	"// Generated by cmake/embed.cmake from ${source}; do not edit.\n"
	"#include <cstddef>\n"
	"namespace gob::embedded {\n"
	"extern const unsigned char ${NAME}[] = {\n\t${bytes}\n};\n"
	"extern const std::size_t ${NAME}Size = ${size};\n"
	"} // namespace gob::embedded\n")
